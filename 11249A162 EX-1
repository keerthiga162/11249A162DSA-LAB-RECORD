#include <stdio.h>

int insert(int a[], int n, int pos, int val) {
    if (pos < 0 || pos > n) return n;
    for (int i = n; i > pos; i--) a[i] = a[i-1];
    a[pos] = val;
    return n + 1;
}

int delete(int a[], int n, int pos) {
    if (pos < 0 || pos >= n) return n;
    for (int i = pos; i < n - 1; i++) a[i] = a[i+1];
    return n - 1;
}

int search(int a[], int n, int val) {
    for (int i = 0; i < n; i++) if (a[i] == val) return i;
    return -1;
}

void display(int a[], int n) {
    for (int i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
}

int main() {
    int a[100], n, ch, pos, val;
    scanf("%d", &n);
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);
    while (1) {
        scanf("%d", &ch);
        if (ch == 1) {
            scanf("%d%d", &pos, &val);
            n = insert(a, n, pos, val);
        } else if (ch == 2) {
            scanf("%d", &pos);
            n = delete(a, n, pos);
        } else if (ch == 3) {
            scanf("%d", &val);
            printf("%d\n", search(a, n, val));
        } else if (ch == 4) {
            display(a, n);
        } else break;
    }
    return 0;
}
