#include <stdio.h>

int linearSearch(int a[], int n, int x) {
    for (int i = 0; i < n; i++)
        if (a[i] == x) return i;
    return -1;
}

int main() {
    int a[100], n, x;
    scanf("%d", &n);
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);
    scanf("%d", &x);
    int p = linearSearch(a, n, x);
    printf("%d\n", p);
    return 0;
}
